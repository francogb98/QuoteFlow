generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  url = env("DATABASE_URL")
}

model Empresa {
  id                 String          @id @default(uuid())
  nombre             String          @unique
  fechaCreacion      DateTime        @default(now())
  fechaActualizacion DateTime        @updatedAt
  planTipo           TipoPlanEmpresa @default(BASICO)

  mercadoPagoPreApprovalId String?
  estadoPago               EstadoEmpresa            @default(ACTIVO)
  frecuenciaPago           FrecuenciaPago           @default(MENSUAL)
  fechaUltimoPago          DateTime?
  fechaProximoVencimiento  DateTime?
  estaActiva               Boolean                  @default(true)
  esCuentaPrueba           Boolean                  @default(false)
  codigoPromocionalId      String?
  fechaFinPrueba           DateTime?
  administradores          Administrador[]
  codigoPromocional        CodigoPromocional?       @relation("EmpresaCodigoPromocional", fields: [codigoPromocionalId], references: [id])
  suscripcion              SuscripcionEmpresa?
  pagoSuscripcionEmpresas  PagoSuscripcionEmpresa[]
}

model SuscripcionEmpresa {
  id        String  @id @default(uuid())
  empresaId String  @unique
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  planTipo       TipoPlanEmpresa
  frecuenciaPago FrecuenciaPago

  mercadoPagoPreApprovalId String?                @unique
  estadoSuscripcion        EstadoSuscripcion      @default(TRIAL)
  estadoPagoMercadoPago    EstadoPagoMercadoPago?

  fechaInicio           DateTime  @default(now())
  fechaFinPeriodoActual DateTime?

  manualOverrideEstado EstadoSuscripcion? // Permite a los administradores anular el estado de la suscripción manualmente
  manualOverrideHasta  DateTime? // Fecha hasta la cual se aplica la anulación manual

  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  pagoSuscripcionEmpresas PagoSuscripcionEmpresa[]
}

model Administrador {
  id                               String                 @id @default(uuid())
  nombre                           String
  documento                        String                 @unique
  email                            String                 @unique
  password                         String
  telefono                         String
  rol                              Rol                    @default(PROFESOR)
  estaActivo                       Boolean                @default(true)
  fechaCreacion                    DateTime               @default(now())
  fechaActualizacion               DateTime               @updatedAt
  empresaId                        String
  claveMercadoPago                 String?
  tokenMercadoPagoExpiresAt        DateTime?
  mercadoPagoRefreshToken          String?
  configuracionTarifaId            String?
  modeloDeCobro                    ModeloDeCobro          @default(COMPROBANTE)
  recibirNotificacionesPago        Boolean                @default(true)
  recibirNotificacionesComprobante Boolean                @default(true)
  emailNotificaciones              Boolean                @default(true)
  permitirModificarTarifa          Boolean                @default(true)
  permitirModificarCobro           Boolean                @default(true)
  resetPasswordTokenHash           String?
  resetPasswordExpires             DateTime?
  configuracionTarifa              ConfiguracionTarifa?   @relation(fields: [configuracionTarifaId], references: [id])
  empresa                          Empresa                @relation(fields: [empresaId], references: [id])
  logs                             AuditLog[]
  notificacionesRecibidas          Notificacion[]         @relation("NotificacionDestinatario")
  notificacionesEnviadas           Notificacion[]         @relation("NotificacionRemitente")
  usuarios                         Usuario[]
  passwordResetTokens              PasswordResetToken[]
  passwordResetSessions            PasswordResetSession[]

  @@index([empresaId])
  @@index([configuracionTarifaId])
}

model Notificacion {
  id              String           @id @default(uuid())
  tipo            TipoNotificacion
  titulo          String
  mensaje         String
  administradorId String?
  usuarioId       String?
  remitenteId     String?
  leida           Boolean          @default(false)
  fechaCreacion   DateTime         @default(now())
  fechaLeida      DateTime?
  entidadTipo     String?
  entidadId       String?
  enviadaPorEmail Boolean          @default(false)
  fechaEnvioEmail DateTime?
  administrador   Administrador?   @relation("NotificacionDestinatario", fields: [administradorId], references: [id])
  remitente       Administrador?   @relation("NotificacionRemitente", fields: [remitenteId], references: [id])
  usuario         Usuario?         @relation("NotificacionUsuario", fields: [usuarioId], references: [id])
  pago            Pago?            @relation(fields: [pagoId], references: [id])
  pagoId          String?

  @@index([administradorId])
  @@index([usuarioId])
  @@index([tipo])
  @@index([leida])
  @@index([fechaCreacion])
}

model CodigoPromocional {
  id              String    @id @default(uuid())
  codigo          String    @unique
  duracionMeses   Int       @default(2)
  estaActivo      Boolean   @default(true)
  fechaCreacion   DateTime  @default(now())
  fechaExpiracion DateTime?
  empresasCreadas Empresa[] @relation("EmpresaCodigoPromocional")

  @@index([codigo])
  @@index([estaActivo])
}

model AuditLog {
  id              String         @id @default(uuid())
  action          String         @db.VarChar(64)
  entityType      String         @db.VarChar(32)
  entityId        String
  details         String?        @db.VarChar(1024)
  ipAddress       String?        @db.VarChar(45)
  userAgent       String?        @db.VarChar(512)
  administradorId String?
  createdAt       DateTime       @default(now())
  administrador   Administrador? @relation(fields: [administradorId], references: [id])

  @@index([action])
  @@index([entityType, entityId])
  @@index([administradorId])
  @@index([createdAt])
}

model Usuario {
  id                   String                       @id @default(uuid())
  nombre               String
  apellido             String
  documento            String
  telefono             String?
  email                String?
  edad                 Int?
  estado               Estado                       @default(ACTIVO)
  administradorId      String
  estaActivo           Boolean                      @default(true)
  fechaCreacion        DateTime                     @default(now())
  fechaInicioMembresia DateTime?
  rangoTarifaId        String?
  dinamicaTarifaId     String?
  nombreTarifaAsignada String?
  notificaciones       Notificacion[]               @relation("NotificacionUsuario")
  pushSubscriptions    PushSubscription[]
  pagos                Pago[]
  administrador        Administrador                @relation(fields: [administradorId], references: [id])
  dinamicaTarifa       ConfiguracionDinamicaTarifa? @relation(fields: [dinamicaTarifaId], references: [id])
  rangoTarifa          RangoTarifa?                 @relation(fields: [rangoTarifaId], references: [id])
  fcmTokens            FcmToken[]

  @@index([documento])
  @@index([administradorId])
  @@index([rangoTarifaId])
  @@index([dinamicaTarifaId])
}

model Pago {
  id               String         @id @default(uuid())
  monto            Float
  fecha            DateTime       @default(now())
  mes              Int
  año             Int
  comprobante      String?
  usuarioId        String
  estaVencido      Boolean        @default(false)
  estado           EstadoPago     @default(PENDIENTE)
  metodo           MetodoPago     @default(EFECTIVO)
  periodo          String
  fechaVencimiento DateTime?
  motivo           String?
  usuario          Usuario        @relation(fields: [usuarioId], references: [id])
  notificacions    Notificacion[]
  updatedAt        DateTime       @default(now()) @updatedAt

  notificado Boolean @default(false)

  @@index([usuarioId])
  @@index([fecha])
  @@index([periodo])
  @@index([fechaVencimiento])
}

model ConfiguracionTarifa {
  id                String                        @id @default(uuid())
  tipoConfiguracion TipoConfiguracionTarifa       @default(FIJA_MENSUAL)
  fechaCreacion     DateTime                      @default(now())
  estaActiva        Boolean                       @default(true)
  administradores   Administrador[]
  dinamicas         ConfiguracionDinamicaTarifa[]
  rangos            RangoTarifa[]
}

model RangoTarifa {
  id                    String              @id @default(uuid())
  nombre                String
  diaInicio             Int
  diaFin                Int
  monto                 Float
  configuracionTarifaId String
  configuracionTarifa   ConfiguracionTarifa @relation(fields: [configuracionTarifaId], references: [id])
  usuarios              Usuario[]

  @@index([configuracionTarifaId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  adminId   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  administrador Administrador @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

model PasswordResetSession {
  id          String   @id @default(cuid())
  sessionHash String   @unique
  adminId     String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  administrador Administrador @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

model ConfiguracionDinamicaTarifa {
  id                    String              @id @default(uuid())
  nombre                String
  montoBase             Float
  diasGracia            Int
  montoRecargo          Float
  configuracionTarifaId String
  configuracionTarifa   ConfiguracionTarifa @relation(fields: [configuracionTarifaId], references: [id])
  usuarios              Usuario[]

  @@index([configuracionTarifaId])
}

model TempRegistration {
  id             String          @id @default(uuid())
  nombre         String
  documento      String          @unique
  email          String          @unique
  nombreEmpresa  String
  password       String
  telefono       String
  planTipo       TipoPlanEmpresa
  frecuenciaPago FrecuenciaPago
  createdAt      DateTime        @default(now())
  expiresAt      DateTime

  @@index([expiresAt])
}

model WebhookEvent {
  id          String    @id @default(uuid())
  providerId  String    @unique
  topic       String
  rawPayload  String
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([providerId])
}

model PagoSuscripcionEmpresa {
  id                       String                @id @default(uuid())
  empresaId                String
  suscripcionId            String
  mercadoPagoPaymentId     String                @unique
  mercadoPagoPreApprovalId String
  monto                    Float
  estadoMercadoPago        EstadoPagoMercadoPago
  fechaPago                DateTime              @default(now())
  rawPayload               String?

  empresa     Empresa            @relation(fields: [empresaId], references: [id])
  suscripcion SuscripcionEmpresa @relation(fields: [suscripcionId], references: [id])

  @@index([empresaId])
  @@index([suscripcionId])
}

enum Estado {
  ACTIVO
  INACTIVO
}

enum EstadoPago {
  PAGADO
  PENDIENTE
  VENCIDO
  RECHAZADO
}

enum MetodoPago {
  EFECTIVO
  MERCADOPAGO
  TRANSFERENCIA
  TARJETA
}

enum Rol {
  ADMINISTRADOR
  PROFESOR
  SUPER_ADMIN
}

enum TipoPlanEmpresa {
  BASICO
  PRO
}

enum EstadoEmpresa {
  ACTIVO
  INACTIVO_POR_FALTA_DE_PAGO
  SUSPENDIDO_MANUALMENTE
}

// Estado lógico de la suscripción (independiente del estado de pago de MercadoPago)
enum EstadoSuscripcion {
  TRIAL // Período de prueba activo
  ACTIVA // Suscripción paga activa
  CANCELADA // Cancelada por el usuario (pero aún tiene acceso hasta vencimiento)
  VENCIDA // Período de pago vencido, sin acceso
  PENDIENTE // Esperando activación (primer pago pendiente)
}

// Estado del pago en MercadoPago
enum EstadoPagoMercadoPago {
  PENDING // Esperando aprobación del usuario
  AUTHORIZED // Pago autorizado
  PAID // Pago realizado
  CANCELLED // Cancelado por el usuario
  REJECTED // Pago rechazado
}

enum FrecuenciaPago {
  MENSUAL
  ANUAL
}

enum TipoConfiguracionTarifa {
  FIJA_MENSUAL
  DINAMICA_POR_FECHA_INGRESO
}

enum TipoNotificacion {
  PAGO_VENCIDO
  PAGO_PROXIMO_VENCER
  COMPROBANTE_SUBIDO
  COMPROBANTE_APROBADO
  COMPROBANTE_RECHAZADO
  PAGO_CONFIRMADO
  RECORDATORIO_PAGO
  SISTEMA
}

enum ModeloDeCobro {
  COMPROBANTE
  MERCADOPAGO
}

model PushSubscription {
  id       String @id @default(uuid())
  endpoint String @unique
  p256dh   String
  auth     String

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([usuarioId])
}

model FcmToken {
  id        String   @id @default(uuid())
  token     String   @unique
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  userAgent String?
  createdAt DateTime @default(now())

  @@index([usuarioId])
}
